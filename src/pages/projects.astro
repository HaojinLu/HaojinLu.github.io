---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectList from '../components/ProjectList.astro';
import { projects } from '../data/projects';
---

<BaseLayout active="projects" description="Selected robotics and AI engineering projects by Haojin Lu, with clearly stated contribution and release scope.">
  <div class="page-heading">
    <p class="eyebrow">Selected Work</p>
    <h1>Selected Projects</h1>
    <p>Public projects covering humanoid robotics, independent development, and backend contributions. Each repository states its contribution and what material is available.</p>
  </div>
  <section aria-label="Selected projects" class="page-list">
    <ProjectList projects={projects} />
  </section>
</BaseLayout>
