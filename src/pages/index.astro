---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectList from '../components/ProjectList.astro';
import ExperienceList from '../components/ExperienceList.astro';
import { projects } from '../data/projects';
import { researchExperience, roboticsExperience } from '../data/experience';
import { site } from '../data/site';

const featuredProjects = projects.filter((project) => project.featured);
---

<BaseLayout active="about">
  <section id="about" class="intro" aria-labelledby="home-title">
    <p class="eyebrow">Undergraduate Student in Artificial Intelligence · Sun Yat-sen University</p>
    <h1 id="home-title">Haojin Lu</h1>
    <p class="lead">I am an undergraduate student in Artificial Intelligence at Sun Yat-sen University. My research interests lie in human-centric embodied intelligence, multimodal AI, and humanoid robotics, especially systems that perceive human behavior, reason about interaction, and translate high-level intent into responsive physical action. I also build agent-based AI systems and research tools.</p>
    <p class="intro-about">My work spans human–robot interaction, humanoid robot deployment, multimodal AI, and agent-based systems. I am interested in closing the loop between human understanding and physical action: how embodied agents interpret language and behavior, generate appropriate actions, and adapt to human feedback in real-world interaction.</p>
    <div class="intro-actions">
      <a class="text-link" href="#research">Explore research <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section id="research" class="content-section" aria-labelledby="research-title">
    <div class="section-heading">
      <p class="section-kicker">01 / Research</p>
      <h2 id="research-title">Research</h2>
    </div>
    <div class="section-body">
      <ExperienceList experiences={[researchExperience]} />
    </div>
  </section>

  <section id="experience" class="content-section" aria-labelledby="experience-title">
    <div class="section-heading">
      <p class="section-kicker">02 / Robotics</p>
      <h2 id="experience-title">Robotics &amp; Technical Experience</h2>
    </div>
    <div class="section-body">
      <ExperienceList experiences={[roboticsExperience]} />
      <a class="section-more" href="/experience/">View experience <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="content-section" aria-labelledby="projects-title">
    <div class="section-heading">
      <p class="section-kicker">03 / Engineering</p>
      <h2 id="projects-title">Selected Engineering Projects</h2>
    </div>
    <div class="section-body">
      <ProjectList projects={featuredProjects} />
      <a class="section-more" href="/projects/">View projects <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="content-section" aria-labelledby="interests-title">
    <div class="section-heading">
      <p class="section-kicker">04 / Interests</p>
      <h2 id="interests-title">Research Interests</h2>
    </div>
    <div class="section-body">
      <p class="interest-list">{site.interests.join(' · ')}</p>
    </div>
  </section>

  <section class="content-section contact-section" aria-labelledby="contact-title">
    <div class="section-heading">
      <p class="section-kicker">05 / Connect</p>
      <h2 id="contact-title">Contact</h2>
    </div>
    <div class="section-body">
      <p>Find my public work on <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>.</p>
      {site.email && <p>Email: <a href={'mailto:' + site.email}>{site.email}</a></p>}
      {site.scholar && <p><a href={site.scholar}>Google Scholar <span aria-hidden="true">↗</span></a></p>}
      {site.linkedin && <p><a href={site.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a></p>}
      {site.orcid && <p><a href={site.orcid}>ORCID <span aria-hidden="true">↗</span></a></p>}
    </div>
  </section>
</BaseLayout>
