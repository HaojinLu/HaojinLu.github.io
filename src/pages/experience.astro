---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceList from '../components/ExperienceList.astro';
import { experiences } from '../data/experience';
---

<BaseLayout active="experience" description="Research and technical experience of Haojin Lu.">
  <div class="page-heading">
    <p class="eyebrow">Background</p>
    <h1>Experience</h1>
    <p>Research and hands-on humanoid robotics experience, with an emphasis on my contributions.</p>
  </div>
  <section class="page-list" aria-label="Experience entries">
    <ExperienceList experiences={experiences} headingLevel={2} />
  </section>
</BaseLayout>
