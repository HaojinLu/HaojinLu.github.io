---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout active="cv" description="Curriculum vitae of Haojin Lu.">
  <div class="page-heading">
    <p class="eyebrow">Background</p>
    <h1>CV</h1>
    <p>My public CV will be available here when the PDF is ready.</p>
  </div>
  <section class="page-list" aria-label="Curriculum vitae">
    {site.cvPdf ? (
      <a class="button-link" href={site.cvPdf} download>Download CV <span aria-hidden="true">↓</span></a>
    ) : (
      <p class="empty-note">CV PDF pending.</p>
    )}
  </section>
</BaseLayout>
